{
  "name": "move-and-play",
  "productName": "Move & Play",
  "version": "1.7.0",
  "description": "Webcam workout games for kids",
  "author": "merchantsteam29",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "postinstall": "node scripts/prepare-offline.js",
    "web": "node server.js",
    "start": "electron .",
    "dist": "node scripts/prepare-offline.js && electron-builder --win"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "^5.0.0",
    "@mediapipe/tasks-vision": "0.10.14",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "qrcode-generator": "^1.4.4"
  },
  "build": {
    "appId": "com.merchantsteam29.moveandplay",
    "productName": "Move & Play",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "share.html",
      "style.css",
      "manifest.webmanifest",
      "js/**",
      "icons/**",
      "vendor/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "vendor/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Move & Play",
      "artifactName": "Move-and-Play-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "Move-and-Play-Portable-${version}.exe"
    }
  }
}
